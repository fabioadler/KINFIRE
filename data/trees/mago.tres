script = ExtResource("2_node_script")
id = &"mago_bola_caos"
skill_id = &"bola_caos"
is_new_skill = true
max_rank = 1
requires = []
per_rank = {}
display_name = "Bola do Caos"
description = "Desbloqueia: Projétil arcano instável. Ricocheteia entre inimigos (até 5x), dano aumenta a cada salto."
icon = "S_Magic07"

script = ExtResource("2_node_script")
