is_new_skill = true
max_rank = 1
requires = []
per_rank = {}
display_name = "Bênção da Aurora"
description = "Desbloqueia: Aura de cura 15m. Aliados regeneram 5% vida/s e ganham +15% resistências. Dura 15s."
icon = "S_Holy03"

script = ExtResource("2_node_script")
